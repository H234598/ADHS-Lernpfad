{
  "name": "adhs-lernpfad-web-assets",
  "private": true,
  "version": "1.1.0",
  "description": "Reproduzierbare Web-, Review- und Markdown-Prüfungen für den ADHS-Lernpfad",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "cytoscape": "3.34.0",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-preset-lint-recommended": "7.0.1"
  },
  "scripts": {
    "check:graph-js": "node --check assets/javascripts/knowledge-graph.js",
    "lint:markdown:changed": "node scripts/remark_lint.mjs --changed",
    "lint:markdown:all": "node scripts/remark_lint.mjs --all",
    "test": "npm run check:graph-js",
    "test:web": "playwright test"
  }
}
